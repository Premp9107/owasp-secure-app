# Copy to .env and replace the secret before any shared or production use.
# Leave DATABASE_URL unset to use the local SQLite file backend/aegis.db.

# DATABASE_URL=postgresql+psycopg://vigil:change-me@localhost:5432/vigil
JWT_SECRET=replace-with-a-long-random-string
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
SEED_DEMO_USERS=true
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=20
RATE_LIMIT_WINDOW_SECONDS=900
ENABLE_DOCS=true
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
